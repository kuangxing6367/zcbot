# 随包分发的运行时资源（wheel/sdist）
include VERSION
include requirements.txt
include startup.py
# 许可与第三方声明：sdist 必须带齐两份协议全文 + 打包组件的版权声明，
# 否则拿到源码包的人看不到 Apache 那份（LICENSE 只放 MIT）。
include LICENSE
include LICENSE-APACHE
include THIRD-PARTY-NOTICES.md
recursive-include framework *.yaml *.yml *.json *.sql *.txt
recursive-include core_plugins *.yaml *.yml *.json *.txt *.sql *.html *.js *.css *.so *.pyd *.ttf *.otf
recursive-include plugins *.yaml *.yml *.json *.txt *.html *.js *.css
recursive-include sql *.sql
# image_renderer 的字体子集与原生扩展是**可选运行时资源**，刻意不入包：
# 7 个平台的二进制里任何一台机器只会用到其中一个，两套字体子集还有 8MB。
# 它们由插件按 asset_url 从独立仓库 zcbot-render-assets 取到 data/ 下，
# 默认的 PIL 后端完全不需要。上面那条 recursive-include 会把它们一起打进
# wheel（include-package-data=true 时 MANIFEST.in 直接决定 wheel 内容），
# 所以必须在这里显式排除，否则每次 pip 安装都多下 10MB。
recursive-exclude core_plugins/image_renderer *.ttf *.otf
recursive-exclude core_plugins/image_renderer/native *.so *.pyd *.dll
# cargo 的编译中间产物（.fingerprint/*.json、build/*.txt）同样不该进包：
# 上面 recursive-include 的 *.json/*.txt 会把它们一起捞进来，体积比代码还大。
prune core_plugins/image_renderer/native/target
prune core_plugins/rust_accel/rust_accel/target
prune framework/iipc/rust_adapter/target
exclude core_plugins/*/native/target/*
exclude core_plugins/rust_accel/rust_accel/target/*
global-exclude __pycache__ *.py[cod] *.db *.db-shm *.db-wal *.db-journal
